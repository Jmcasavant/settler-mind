# Copy to .env (git-ignored) and fill in. Loaded by ./gradlew runEval, runClient, runServer and
# runGametest. Real environment variables take precedence over this file.
# Same convention as minecraft-civ-lab: you can copy the key from that repo's .env.
#
# Anthropic API key for the "claude" provider (routes in config/settlermind.json, or runEval --provider claude).
# The mod reads it from the variable named by claude.apiKeyEnv in config (default ANTHROPIC_API_KEY).
ANTHROPIC_API_KEY=
