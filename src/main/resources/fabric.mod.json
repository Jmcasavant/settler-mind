{
  "schemaVersion": 1,
  "id": "settlermind",
  "version": "${version}",
  "name": "Settler Mind (codename)",
  "description": "AI settlers with personalities, needs, memories and relationships. They decide for themselves, talk, remember, and learn from failure.",
  "authors": [
    "SettlerMind contributors"
  ],
  "license": "All-Rights-Reserved",
  "environment": "*",
  "entrypoints": {
    "main": [
      "dev.settlermind.SettlerMind"
    ],
    "client": [
      "dev.settlermind.client.SettlerMindClient"
    ],
    "fabric-gametest": [
      "dev.settlermind.gametest.SettlerGameTests"
    ]
  },
  "depends": {
    "fabricloader": ">=0.15.0",
    "minecraft": "~1.20.1",
    "java": ">=17",
    "fabric-api": "*",
    "fabric-language-kotlin": ">=1.10.0"
  }
}